# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
next-env.d.ts
*.tsbuildinfo

# production
/build

# misc
.DS_Store
*.pem
.claude/worktrees/
AGENTS.md

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# supabase link writes the project ID here
supabase/.temp

# local sandbox: the fake owner's TOTP secret, its session, production mode's
# process ID and test output
sandbox/.owner-totp
sandbox/.session.json
sandbox/.production.pid
sandbox/.results
sandbox/.shots

# typescript
Budget Builder.code-workspace
.vscode/settings.json
Projects.code-workspace
